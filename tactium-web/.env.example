NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TACTIUM_WRITES=off

# ── Cobro por torneo (Stripe) · Fase 2 ──────────────────────────────────────
# Service role (SECRETO, solo servidor) para que el webhook confirme pagos.
SUPABASE_SERVICE_ROLE_KEY=
# Claves de Stripe (empieza en modo test: sk_test_… / pk_test_…).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook (Stripe → /api/tournaments/webhook).
STRIPE_WEBHOOK_SECRET=
# Secreto del webhook de SUSCRIPCIONES (Stripe → /api/subscription/webhook).
# Se configura como un endpoint aparte en Stripe con su propio secreto. Si se
# deja vacío, se reutiliza STRIPE_WEBHOOK_SECRET.
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
# URL pública de la web (para success/cancel del checkout). Ej: https://tactium.io
NEXT_PUBLIC_APP_URL=
# Correo transaccional (Resend). Necesario para mandar el enlace de pago del
# torneo: la app NO puede enlazar a un pago que no sea IAP, así que va por email.
# Sin clave, la ruta responde emailed:false y no rompe nada.
RESEND_API_KEY=
EMAIL_FROM=TACTIUM <no-reply@tactium.io>
# Logo en las cabeceras de los correos (opcional; cae a un logo por defecto).
EMAIL_LOGO_URL=
