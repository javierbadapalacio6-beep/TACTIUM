# Copia este archivo a `.env` (sin ".example") y rellena los valores.
# El .env real está en .gitignore: no se sube al repo.

# Token de acceso de la app de Instagram (Meta for Developers → Instagram →
# API con inicio de sesión de empresa → "1. Generar identificadores de acceso").
IG_ACCESS_TOKEN=

# ID de la cuenta profesional de Instagram (tactium.io). Aparece junto al
# token al generarlo, o se puede consultar con:
#   curl "https://graph.instagram.com/v22.0/me?fields=id,username&access_token=TU_TOKEN"
IG_ACCOUNT_ID=
# fal.ai (clips e imágenes con IA)
FAL_KEY=
