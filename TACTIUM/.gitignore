# Expo local state (device history, dev server settings)
.expo/

# EAS local cache
.eas/

# Native folders generated by `expo prebuild` (managed workflow regenera)
# Si pasáis a bare workflow, quitar estas líneas y commitear ios/android.
ios/
android/

# Builds locales
*.ipa
*.apk
*.aab

# Service account keys (Google Play) — NUNCA en repo
google-service-account.json
google-services.json
# Clave de service account de Firebase (FCM v1) — secreto, NUNCA en repo
*firebase-adminsdk*.json

# Apple cert export + ASC API keys — NUNCA en repo
*.p12
*.mobileprovision
*.p8

# Logs y temporales
*.log
npm-debug.log*
yarn-debug.log*
.expo-shared/
